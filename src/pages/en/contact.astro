---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import ContactForm from '../../components/ContactForm.astro';

const email = 'zentra.digital.studio@gmail.com';
const whatsapp = 'https://wa.me/5492281325647';
---

<MainLayout
  lang="en"
  title="Contact ZENTRA | Start a Project"
  description="Contact ZENTRA by email or WhatsApp, or tell us about your project through the inquiry form."
>
  <SiteHeader />
  <main id="contenido">
    <PageHero
      eyebrow="CONTACT"
      title="Every good website starts with a conversation."
      description="Tell us what you would like to build. Choose whichever contact option works best for you."
    />

    <section class="section contact-page" aria-labelledby="contact-page-title">
      <div class="container">
        <div class="contact-page__grid">
          <div class="contact-page__intro">
            <SectionHeading id="contact-page-title" eyebrow="LET’S TALK ABOUT YOUR IDEA" title="Your next step starts with an inquiry." description="Email us directly or share the basic details of your project in the form." />
            <div class="contact-channels" aria-label="Contact options">
              <a class="contact-channel" href={`mailto:${email}`}>
                <span class="contact-channel__icon" aria-hidden="true">@</span>
                <span><strong>Email</strong><small>{email}</small></span>
                <span class="contact-channel__arrow" aria-hidden="true">↗</span>
              </a>
              <a class="contact-channel" href={whatsapp} target="_blank" rel="noopener noreferrer">
                <span class="contact-channel__icon" aria-hidden="true">↗</span>
                <span><strong>WhatsApp</strong><small>Message us on WhatsApp</small></span>
                <span class="contact-channel__arrow" aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="contact-page__actions">
              <Button href="/en/services" variant="text" arrow>Explore services</Button>
              <Button href="/en/work" variant="text" arrow>View projects</Button>
            </div>
          </div>

          <ContactForm lang="en" />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
