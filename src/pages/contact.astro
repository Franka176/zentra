---
import MainLayout from '../layouts/MainLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.astro';

const email = 'zentra.digital.studio@gmail.com';
const whatsapp = 'https://wa.me/5492281325647';
---

<MainLayout
  title="Contacto | Iniciá un proyecto con ZENTRA"
  description="Contactá a ZENTRA por correo o WhatsApp, o contanos sobre tu proyecto mediante el formulario."
>
  <SiteHeader />
  <main id="contenido">
    <PageHero
      eyebrow="CONTACTO"
      title="Toda buena web empieza con una conversación."
      description="Contanos qué te gustaría construir. Elegí el canal que te resulte más cómodo."
    />

    <section class="section contact-page" aria-labelledby="contact-page-title">
      <div class="container">
        <div class="contact-page__grid">
          <div class="contact-page__intro">
            <SectionHeading id="contact-page-title" eyebrow="HABLEMOS DE TU IDEA" title="El próximo paso empieza con tu consulta." description="Podés escribirnos directamente o enviar los detalles básicos de tu proyecto en el formulario." />
            <div class="contact-channels" aria-label="Canales de contacto">
              <a class="contact-channel" href={`mailto:${email}`}>
                <span class="contact-channel__icon" aria-hidden="true">@</span>
                <span><strong>Correo electrónico</strong><small>{email}</small></span>
                <span class="contact-channel__arrow" aria-hidden="true">↗</span>
              </a>
              <a class="contact-channel" href={whatsapp} target="_blank" rel="noopener noreferrer">
                <span class="contact-channel__icon" aria-hidden="true">↗</span>
                <span><strong>WhatsApp</strong><small>Escribinos por WhatsApp</small></span>
                <span class="contact-channel__arrow" aria-hidden="true">↗</span>
              </a>
            </div>
            <div class="contact-page__actions">
              <Button href="/services" variant="text" arrow>Explorar servicios</Button>
              <Button href="/work" variant="text" arrow>Ver proyectos</Button>
            </div>
          </div>

          <ContactForm lang="es" />
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</MainLayout>
