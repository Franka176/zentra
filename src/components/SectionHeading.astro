---
interface Props {
  eyebrow: string;
  title: string;
  id?: string;
  description?: string;
  align?: 'left' | 'center';
  light?: boolean;
}

const { eyebrow, title, id, description, align = 'left', light = false } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${align}`, light && 'section-heading--light']}>
  <p class="eyebrow"><span class="eyebrow__mark" aria-hidden="true"></span>{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</div>
