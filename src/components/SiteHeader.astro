---
import Button from './Button.astro';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="ZENTRA, inicio">
      <span class="brand__word">ZENTRA<span class="brand__dot">.</span></span>
      <span class="brand__descriptor">Digital Development</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Abrir menú">
      <span></span><span></span>
    </button>

    <nav class="site-nav" id="primary-navigation" aria-label="Navegación principal" inert>
      <a href="/services" aria-current={Astro.url.pathname === '/services' ? 'page' : undefined}>Servicios</a>
      <a href="/work" aria-current={Astro.url.pathname === '/work' ? 'page' : undefined}>Proyectos</a>
      <a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>Nosotros</a>
      <a href="/contact" aria-current={Astro.url.pathname === '/contact' ? 'page' : undefined}>Contacto</a>
      <div class="language-switch" aria-label="Idioma">
        <span aria-current="true">ES</span>
        <span class="language-switch__divider" aria-hidden="true">/</span>
        <span class="language-switch__soon" aria-disabled="true" title="Versión en inglés próximamente">EN</span>
      </div>
      <Button href="/contact" variant="primary" className="site-nav__cta" arrow>Hablemos</Button>
    </nav>
  </div>
</header>
