---
import Button from './Button.astro';

const language = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const prefix = language === 'en' ? '/en' : '';
const year = new Date().getFullYear();
const copy = language === 'en'
  ? {
      eyebrow: 'THE NEXT STEP STARTS HERE', titleLineOne: 'Ready to shape', titleLineTwo: 'your next idea?', note: 'Tell us about your next project or explore ZENTRA services and concept projects.', explore: 'Explore services', home: 'ZENTRA, back to home', exploreTitle: 'Explore', services: 'Services', work: 'Work', about: 'About', process: 'Process', contact: 'Contact', contactNote: 'Email, WhatsApp, and the project inquiry form are available.', contactOptions: 'Contact ZENTRA', legal: 'Legal information', privacy: 'Privacy', terms: 'Terms', back: 'Back to top', copyright: 'All rights reserved.',
    }
  : {
      eyebrow: 'EL PRÓXIMO PASO EMPIEZA ACÁ', titleLineOne: '¿Le damos forma', titleLineTwo: 'a tu próxima idea?', note: 'Escribinos sobre tu próximo proyecto o conocé los servicios y proyectos conceptuales de ZENTRA.', explore: 'Explorar servicios', home: 'ZENTRA, volver al inicio', exploreTitle: 'Explorar', services: 'Servicios', work: 'Proyectos', about: 'Nosotros', process: 'Proceso', contact: 'Contacto', contactNote: 'Podés escribir por correo o WhatsApp, o enviar una consulta mediante el formulario.', contactOptions: 'Contactar a ZENTRA', legal: 'Información legal', privacy: 'Privacidad', terms: 'Términos', back: 'Volver al inicio', copyright: 'Todos los derechos reservados.',
    };
const homeHref = language === 'en' ? '/en' : '/';
---

<footer class="site-footer" id={language === 'en' ? 'contact' : 'contacto'}>
  <div class="container">
    <div class="footer-cta">
      <div>
        <p class="eyebrow"><span class="eyebrow__mark" aria-hidden="true"></span>{copy.eyebrow}</p>
        <h2>{copy.titleLineOne}<br />{copy.titleLineTwo}</h2>
      </div>
      <p class="footer-cta__note">{copy.note}</p>
      <Button href={prefix + '/services'} variant="primary" arrow>{copy.explore}</Button>
    </div>

    <div class="footer-main">
      <div class="footer-brand-block">
        <a class="brand" href={homeHref} aria-label={copy.home}>
          <span class="brand__word">ZENTRA<span class="brand__dot">.</span></span>
          <span class="brand__descriptor">Digital Development</span>
        </a>
        <p>Built for what's next.</p>
      </div>

      <div class="footer-column">
        <h3>{copy.exploreTitle}</h3>
        <a href={prefix + '/services'}>{copy.services}</a>
        <a href={prefix + '/work'}>{copy.work}</a>
        <a href={prefix + '/about'}>{copy.about}</a>
        <a href={homeHref + '#proceso'}>{copy.process}</a>
      </div>

      <div class="footer-column">
        <h3>{copy.services}</h3>
        <a href={prefix + '/services#landing-pages'}>Landing Pages</a>
        <a href={prefix + '/services#business-websites'}>{language === 'en' ? 'Business Websites' : 'Sitios para negocios'}</a>
        <a href={prefix + '/services#website-redesign'}>{language === 'en' ? 'Website Redesign' : 'Rediseño web'}</a>
        <a href={prefix + '/services#website-maintenance'}>{language === 'en' ? 'Website Maintenance' : 'Mantenimiento'}</a>
      </div>

      <div class="footer-column footer-column--contact">
        <h3>{copy.contact}</h3>
        <p>{copy.contactNote}</p>
        <a href={prefix + '/contact'}>{copy.contactOptions}</a>
        <h3 class="footer-column__legal-heading">{copy.legal}</h3>
        <a href={prefix + '/privacy'}>{copy.privacy}</a>
        <a href={prefix + '/terms'}>{copy.terms}</a>
        <a class="footer-back-top" href={homeHref}>{copy.back} <span aria-hidden="true">↑</span></a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} ZENTRA. {copy.copyright}</p>
      <p>Built for what's next.</p>
    </div>
  </div>
</footer>
