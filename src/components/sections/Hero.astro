---
import Button from '../Button.astro';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const copy = lang === 'en'
  ? { eyebrow: 'DIGITAL DEVELOPMENT', first: 'Build your digital presence.', second: 'Move your business forward.', description: 'We create modern, responsive websites that help businesses and entrepreneurs build a stronger online presence.', services: 'Explore our services', work: 'View our work', caption: 'Thoughtful design. Clear development.', scroll: 'SCROLL TO EXPLORE' }
  : { eyebrow: 'DESARROLLO DIGITAL', first: 'Construí tu presencia digital.', second: 'Impulsá tu negocio.', description: 'Creamos sitios web modernos y adaptables para que negocios y emprendedores construyan una presencia online más sólida.', services: 'Explorar servicios', work: 'Ver proyectos', caption: 'Diseño con intención. Desarrollo con claridad.', scroll: 'DESLIZÁ PARA EXPLORAR' };
---

<section class="hero dark-section" id="inicio" aria-labelledby="hero-title">
  <div class="hero__grid-lines" aria-hidden="true"></div>
  <div class="container hero__layout">
    <div class="hero__copy">
      <p class="eyebrow"><span class="eyebrow__mark" aria-hidden="true"></span>{copy.eyebrow}</p>
      <h1 id="hero-title">{copy.first}<br /><span>{copy.second}</span></h1>
      <p class="hero__description">{copy.description}</p>
      <div class="hero__actions">
        <Button href="#servicios" variant="primary" arrow>{copy.services}</Button>
        <Button href="#proyectos" variant="secondary" arrow>{copy.work}</Button>
      </div>
      <p class="hero__tagline">Built for what's next<span>.</span></p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="hero-art__orbit hero-art__orbit--outer"></div>
      <div class="hero-art__orbit hero-art__orbit--inner"></div>
      <div class="hero-art__cross hero-art__cross--one"></div>
      <div class="hero-art__cross hero-art__cross--two"></div>
      <div class="hero-art__core">
        <div class="hero-art__topline"><span>Z / DIGITAL STUDIO</span><span>01—04</span></div>
        <div class="hero-art__monogram">Z<span>.</span></div>
        <div class="hero-art__baseline"><span>IDEAS INTO INTERFACES</span><i></i></div>
      </div>
      <div class="hero-art__caption"><span></span>{copy.caption}</div>
    </div>
  </div>
  <div class="container hero__bottom"><span>ARGENTINA <i></i> WORLDWIDE</span><a href="#servicios">{copy.scroll} <span aria-hidden="true">↓</span></a></div>
</section>
