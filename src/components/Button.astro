---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  className?: string;
  arrow?: boolean;
  label?: string;
}

const { href, variant = 'primary', className = '', arrow = false, label } = Astro.props;
---

<a class:list={['button', `button--${variant}`, className]} href={href} aria-label={label}>
  <slot />
  {arrow && <svg aria-hidden="true" viewBox="0 0 20 20" width="18" height="18"><path d="M3.75 10h12.5m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}
</a>
