---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ZENTRA — Desarrollo digital',
  description = 'Diseñamos y desarrollamos sitios web modernos para negocios y emprendedores. ZENTRA, desarrollo digital construido para lo que viene.',
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = Astro.site ? new URL(pathname, Astro.site) : undefined;
const sitemapUrl = Astro.site ? new URL('/sitemap-index.xml', Astro.site) : undefined;
const socialImage = Astro.site ? new URL('/social-card.png', Astro.site) : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1220" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="ZENTRA" />
    {canonical && <link rel="canonical" href={canonical.href} />}
    {canonical && <meta property="og:url" content={canonical.href} />}
    {socialImage && <meta property="og:image" content={socialImage.href} />}
    {socialImage && <meta property="og:image:secure_url" content={socialImage.href} />}
    {socialImage && <meta property="og:image:type" content="image/png" />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="ZENTRA — Desarrollo digital. Built for what's next." />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage.href} />}
    {socialImage && <meta name="twitter:image:alt" content="ZENTRA — Desarrollo digital. Built for what's next." />}
    {sitemapUrl && <link rel="sitemap" href={sitemapUrl.href} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
